<section>
    <h2>Template Element</h2>

    <p>
        The content inside this template is stored in the page but is not
        displayed unless JavaScript is used to copy it into the document.
    </p>

    <template id="project-template">
        <article>
            <h3>Example Project</h3>
            <p>This content is stored inside a template element.</p>
        </article>
    </template>
</section>

<section>
    <h2>Audio Element</h2>

    <audio controls>
        <source src="/media/audio.wav" type="audio/wav">
        Your browser does not support the audio element.
    </audio>
</section>

<section>
    <h2>Video Element</h2>

    <video controls width="500">
        <source src="/media/video.mp4" type="video/mp4">
        Your browser does not support the video element.
    </video>
</section>

<section>
    <h2>Canvas Element</h2>

    <p>
        The canvas below creates an area that could be used for drawings
        or graphics.
    </p>

    <canvas width="500" height="200">
        Your browser does not support the canvas element.
    </canvas>
</section>

<section>
    <h2>Hello World Custom Element</h2>

    <p>
        This custom element prints a message to the browser console without
        changing the page content.
    </p>

    <hello-world></hello-world>
</section>

