---
layout: base.njk
title: Projects
description: Explore Carolyn's computer science and web development projects.
---

<section>
    <h2>Projects!</h2>

    {% for project in projects %}
        <project-card>
            <h3>
                <a href="/projects/{{ project.slug }}/">
                    {{ project.title }}
                </a>
            </h3>

            <p>{{ project.description }}</p>

            <p>
                <a href="/projects/{{ project.slug }}/">
                    View project
                </a>
            </p>
        </project-card>
    {% endfor %}
</section>

